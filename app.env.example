# Copie para app.env (cp app.env.example app.env) para rodar fora do Docker.
# Valores somente para desenvolvimento local: troque TOKEN_SYMMETRIC_KEY em qualquer outro ambiente.
ENVIRONMENT=development
DB_DRIVER=postgres
DB_SOURCE=postgresql://root:secret@localhost:5433/oficina?sslmode=disable
SERVER_ADDRESS=0.0.0.0:8080
# paseto (padrão) ou jwt
TOKEN_TYPE=paseto
# Exatamente 32 caracteres para PASETO (mínimo 32 para JWT)
TOKEN_SYMMETRIC_KEY=dev-only-change-me-0123456789abc
ACCESS_TOKEN_DURATION=15m
REFRESH_TOKEN_DURATION=24h
ADMIN_NOTIFICATION_TO=admin@oficina.com
